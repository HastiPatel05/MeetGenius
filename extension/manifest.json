{
  "manifest_version": 3,
  "name": "Smart Meeting Companion",
  "version": "1.0",
  "description": "AI-powered real-time meeting transcription, summarization, and translation.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Smart Meeting Companion"
  }
}
